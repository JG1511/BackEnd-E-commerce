generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id_usuario    String           @id @default(uuid())
  nome          String
  cpf           String           @unique
  email         String           @unique
  senha         String
  carrinho      Carrinho[]
  compra        Compra[]
  listaFavorito Lista_Favorito[]
  recomendacao  Recomendacao[]
}

model Produto {
  id_produto    String           @id @default(uuid())
  nome          String
  descricao     String
  preco         Decimal
  cor           String
  modelo        String
  categoriaID   Int
  itemCarrinho  Item_Carrinho[]
  itemCompra    Item_Compra[]
  listaFavorito Lista_Favorito[]
  categoria     Categoria        @relation(fields: [categoriaID], references: [id_categoria])
  recomendacao  Recomendacao[]
}

model Categoria {
  id_categoria  Int       @id @default(autoincrement())
  nomeCategoria String
  descricao     String
  produto       Produto[]
}

model Recomendacao {
  id_recomendacao Int     @id @default(autoincrement())
  usuarioId       String
  produtoId       String
  produto         Produto @relation(fields: [produtoId], references: [id_produto])
  usuario         Usuario @relation(fields: [usuarioId], references: [id_usuario])

  @@unique([produtoId, usuarioId])
}

model Lista_Favorito {
  id_favorito Int     @id @default(autoincrement())
  usuarioId   String
  produtoId   String
  produto     Produto @relation(fields: [produtoId], references: [id_produto])
  usuario     Usuario @relation(fields: [usuarioId], references: [id_usuario])

  @@unique([produtoId, usuarioId])
}

model Carrinho {
  id_carrinho  String          @id @default(uuid())
  usuarioId    String
  status       String
  data_criacao DateTime        @default(now())
  usuario      Usuario         @relation(fields: [usuarioId], references: [id_usuario])
  itemCarrinho Item_Carrinho[]
}

model Item_Carrinho {
  id_item        Int      @id @default(autoincrement())
  produtoId      String
  carrinhoId     String
  quantidade     Int
  preco_unitario Decimal
  carrinho       Carrinho @relation(fields: [carrinhoId], references: [id_carrinho])
  produto        Produto  @relation(fields: [produtoId], references: [id_produto])

  @@unique([produtoId, carrinhoId])
}

model Compra {
  id_compra       String        @id @default(uuid())
  usuarioId       String
  data_compra     DateTime      @default(now())
  total           Decimal
  status          String
  forma_pagamento String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id_usuario])
  itemCompra      Item_Compra[]
}

model Item_Compra {
  id_item_compra Int     @id @default(autoincrement())
  compraId       String
  produtoId      String
  compra         Compra  @relation(fields: [compraId], references: [id_compra])
  produto        Produto @relation(fields: [produtoId], references: [id_produto])

  @@unique([compraId, produtoId])
}
